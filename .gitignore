# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/

# secrets and keys (never commit)
*.pem
*.key
*.crt
*.p12
*.pfx
*.sqlite
*.db
credentials*.json
service-account*.json

# local AI tool state (per-machine, not part of the project)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# logs
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
